// vim: ft=arm

// no preservation either for v0-v7 and v16-v31

{% from "arm64simd_silu_f32_ops.j2" import silu4, silu1 %}

.text
.align 4

.cpu generic+fp+simd
.global {{G}}arm64simd_silu_f32_4n_{{suffix}}
{{G}}arm64simd_silu_f32_4n_{{suffix}}:

    cmp         x1, #0
    beq         .return

    adr         x2, .coeffs_num
    ld1         { v0.4s, v1.4s, v2.4s, v3.4s }, [x2]
    dup         v5.4s, v0.s[0]              // v5 <- low, broadcasted
    dup         v6.4s, v0.s[1]              // v6 <- high, broadcasted
    dup         v7.4s, v3.s[1]              // v7 <- 0.5, broadcasted

    cmp         x1, #16
    blt         .loop

.loop4:
    ld1         { v16.4s, v17.4s, v18.4s, v19.4s }, [x0]
    {{ silu4() }}
    st1         { v16.4s, v17.4s, v18.4s, v19.4s }, [x0], #64

    subs        x1, x1, #16
    cmp         x1, #16
    bge         .loop4

    cmp         x1, #0
    beq         .return

.loop:
    ld1         { v16.4s }, [x0]
    {{ silu1("v16", "v8", "v20", "v24", "v28") }}
    st1         { v16.4s }, [x0], #16

    subs        x1, x1, #4
    bne         .loop

.return:
    ret

.coeffs_num:
    .float -18.6                    // low
    .float 18.6                     // high
    .float -4.433153405e-18         // alpha_13
    .float 1.169974371e-14

    .float -1.875289645e-11
    .float 4.257889523e-8
    .float 0.00004811817576
    .float 0.008163842030

    .float 0.2499999971
    .float 3.922935744e-6           // beta_6
    .float 0.001524872358
    .float 0.1159886749

    .float 1.0
    .float 0.5
    .float 0.0                      // padding
    .float 0.0
