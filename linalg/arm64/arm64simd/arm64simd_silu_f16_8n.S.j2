// vim: ft=arm

// no preservation either for v0-v7 and v16-v31

// f16 SiLU: the math runs in f32 (arm64simd_silu_f32_ops.j2), reusing the f32
// kernel body. Input is widened with fcvtl and results narrowed with fcvtn, so
// f16<->f32 conversion happens in registers only, never through memory. Only
// the (base ARMv8) conversion instructions are used, so no +fp16 arithmetic is
// required.

{% from "arm64simd_silu_f32_ops.j2" import silu4, silu1 %}

.text
.align 4

.cpu generic+fp+simd
.global {{G}}arm64simd_silu_f16_8n_{{suffix}}
{{G}}arm64simd_silu_f16_8n_{{suffix}}:

    cmp         x1, #0
    beq         .return

    adr         x2, .coeffs_num
    ld1         { v0.4s, v1.4s, v2.4s, v3.4s }, [x2]
    dup         v5.4s, v0.s[0]              // v5 <- low, broadcasted
    dup         v6.4s, v0.s[1]              // v6 <- high, broadcasted
    dup         v7.4s, v3.s[1]              // v7 <- 0.5, broadcasted

    cmp         x1, #16
    blt         .loop

.loop4:
    ld1         { v12.8h, v13.8h }, [x0]

    fcvtl       v16.4s, v12.4h
    fcvtl2      v17.4s, v12.8h
    fcvtl       v18.4s, v13.4h
    fcvtl2      v19.4s, v13.8h

    {{ silu4() }}

    fcvtn       v12.4h, v16.4s
    fcvtn2      v12.8h, v17.4s
    fcvtn       v13.4h, v18.4s
    fcvtn2      v13.8h, v19.4s

    st1         { v12.8h, v13.8h }, [x0], #32

    subs        x1, x1, #16
    cmp         x1, #16
    bge         .loop4

    cmp         x1, #0
    beq         .return

.loop:
    ld1         { v12.8h }, [x0]

    fcvtl       v16.4s, v12.4h
    fcvtl2      v17.4s, v12.8h

    {{ silu1("v16", "v8", "v20", "v24", "v28") }}
    {{ silu1("v17", "v9", "v21", "v25", "v29") }}

    fcvtn       v12.4h, v16.4s
    fcvtn2      v12.8h, v17.4s

    st1         { v12.8h }, [x0], #16

    subs        x1, x1, #8
    bne         .loop

.return:
    ret

.coeffs_num:
    .float -18.6                    // low
    .float 18.6                     // high
    .float -4.433153405e-18         // alpha_13
    .float 1.169974371e-14

    .float -1.875289645e-11
    .float 4.257889523e-8
    .float 0.00004811817576
    .float 0.008163842030

    .float 0.2499999971
    .float 3.922935744e-6           // beta_6
    .float 0.001524872358
    .float 0.1159886749

    .float 1.0
    .float 0.5
    .float 0.0                      // padding
    .float 0.0
